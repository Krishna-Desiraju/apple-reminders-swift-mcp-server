{
  "name": "apple-reminders-mcp-server",
  "version": "0.2.0",
  "description": "A comprehensive Model Context Protocol (MCP) server for Apple Reminders on macOS with full CRUD operations, recurring reminders, location triggers, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "apple-reminders-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krishna-Desiraju/apple-reminders-swift-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Krishna-Desiraju/apple-reminders-swift-mcp-server/issues"
  },
  "homepage": "https://github.com/Krishna-Desiraju/apple-reminders-swift-mcp-server#readme",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:live": "RUN_LIVE_REMINDERS=1 vitest run tests/live",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "build:swift": "./scripts/build-swift-cli.sh",
    "setup": "./scripts/setup.sh",
    "clean": "./scripts/clean.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apple",
    "reminders",
    "eventkit",
    "macos",
    "swift",
    "ai",
    "claude"
  ],
  "author": "Krishna Desiraju",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
